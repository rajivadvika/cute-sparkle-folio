{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cute-sparkle-folio",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "directory": "./dist"
  },
  "build": {
    "command": "npm run build",
    "cwd": "."
  }
}