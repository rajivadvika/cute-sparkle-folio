# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/ → Project Settings → API

# Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public/anon key (safe to expose to client)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Server-side Supabase URL (same as client-side)
SUPABASE_URL=https://your-project-id.supabase.co

# Server-side Supabase key
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
